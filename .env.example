# Copy values into your hosting provider's environment settings.
# Local development uses http://127.0.0.1:8765 unless overridden.
PHOTOJOY_PUBLIC_URL=https://your-photojoy-service.example
PHOTOJOY_DATA_DIR=/data
# Public OAuth WEB client ID; no Google client secret is used by this flow.
GOOGLE_CLIENT_ID=
PHOTOJOY_REGISTRATION=true
PHOTOJOY_USER_QUOTA_MB=2048
